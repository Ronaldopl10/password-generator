# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.example
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Documentación de desarrollo interna
MDs/
.vscode*


# Graphify: archivos locales que no comparten estado entre máquinas
# (no commitear: basado en mtime, se rompe en otro clone)
graphify-out/manifest.json
# (no commitear: solo local, no relevante para el equipo)
graphify-out/cost.json
# (no commitear: entorno python local)
graphify-out/.graphify_python
# (no commitear: archivos temporales de extracción)
graphify-out/.graphify_*.json
# (opcional: commit para speed, ignorar para repo chico)
graphify-out/cache/