generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwords            Password[]
  passwordResetTokens  PasswordResetToken[]
  subscription         Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  maxPasswords Int
  price       Float
  /// Reservado para el plan anual (ej. "month" | "year"). Sin UI todavía.
  interval    String?
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  planId    String
  status    String   @default("active")
  /// Pasarela que originó la suscripción: "mercadopago" | "dodo".
  provider String?
  /// Id externo de la suscripción en la pasarela (Dodo: `sub_…`).
  externalId String? @unique
  /// Fin del período pago vigente, según el último webhook aplicado.
  currentPeriodEnd DateTime?
  /// true cuando el usuario canceló pero mantiene el acceso hasta el fin del período.
  cancelAtPeriodEnd Boolean @default(false)
  /// Marca de tiempo del último evento aplicado; sirve para descartar eventos viejos.
  lastEventAt DateTime?
  /// Mutex corto del checkout en curso: lo toma la ruta al crear la sesión y lo
  /// suelta al terminar (o al aplicar el webhook). Es la única barrera contra
  /// dos sesiones simultáneas para el mismo usuario; el TTL de 60 s es la red.
  checkoutLockUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model Password {
  id String @id @default(cuid())

  title             String
  encryptedPassword String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  length       Int     @default(4)
  hasUppercase Boolean @default(false)
  hasLowercase Boolean @default(false)
  hasNumbers   Boolean @default(false)
  hasSymbols   Boolean @default(false)

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cola durable de webhooks de cobros (idempotencia, reintentos y auditoría).
model BillingWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  webhookId   String   @unique
  eventType   String
  payload     Json
  /// pending | processing | done | ignored | failed | dead
  status      String   @default("pending")
  attempts    Int      @default(0)
  lastError   String?
  leaseUntil  DateTime?
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([token])
}
